<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Recommended</AnalysisMode>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1848;CA1873;EnableGenerateDocumentationFile;IDE0060;CA2007</NoWarn>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Every project imports this file and builds in parallel, so writing .git/config on each build
    makes the projects race for its lock. Read the current value first and write only when it differs.
  -->
  <Target Name="ConfigureGitHooks" BeforeTargets="Build" Condition="'$(CI)' == ''">
    <PropertyGroup>
      <_GitHooksPath>$(MSBuildThisFileDirectory).hooks</_GitHooksPath>
    </PropertyGroup>
    <Exec Command="git config --get core.hooksPath" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CurrentGitHooksPath" />
    </Exec>
    <Exec Condition="'$(_CurrentGitHooksPath)' != '$(_GitHooksPath)'" Command="git config core.hooksPath &quot;$(_GitHooksPath)&quot;" ContinueOnError="true" />
    <Exec Condition="'$(_CurrentGitHooksPath)' != '$(_GitHooksPath)'" Command="chmod +x &quot;$(_GitHooksPath)/pre-commit&quot;" ContinueOnError="true" />
  </Target>

</Project>
